# .env.local.example
# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AES-256-GCM key for encrypting manfaat/risk_analysis, 32 random bytes as base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
COMPASS_ENCRYPTION_KEY=

# IANA timezone used for "today" (Dashboard, Schedule). Defaults to UTC if unset.
APP_TIMEZONE=Asia/Jakarta

# AI provider: at least one of the two blocks below is required.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# AI_PROVIDER_ORDER=groq,cloudflare
